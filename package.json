{
  "name": "stock-signal-scanner",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:dev": "wrangler dev",
    "cf:deploy:dev": "wrangler deploy --config wrangler.worker.toml --env=\"\"",
    "cf:deploy:production": "wrangler deploy --config wrangler.worker.toml --env production",
    "cf:pages:dev": "wrangler pages dev cloudflare/pages",
    "cf:pages:deploy:dev": "wrangler pages deploy cloudflare/pages --project-name stock-signal-scanner-monitor-dev",
    "cf:pages:deploy:production": "wrangler pages deploy cloudflare/pages --project-name stock-signal-scanner-monitor",
    "cf:d1:create:dev": "wrangler d1 create stock_signal_scanner_dev",
    "cf:d1:create:production": "wrangler d1 create stock_signal_scanner_production",
    "cf:d1:migrate:local": "wrangler d1 execute stock_signal_scanner_dev --local --file=cloudflare/schema.sql",
    "cf:d1:migrate:dev": "wrangler d1 execute stock_signal_scanner_dev --remote --file=cloudflare/schema.sql",
    "cf:d1:migrate:production": "wrangler d1 execute stock_signal_scanner_production --remote --file=cloudflare/schema.sql",
    "test:worker-contract": "node tests/worker-contract-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
